# Minimal .env for a clean deployment — copy to
# /share/Container/tv-app-launcher-no-api/.env and fill in the two tokens.
#
# Nothing SmartThings-related appears here. The service launches the app over
# the LAN and hosts the sensor's readings itself, so it needs no PAT, no OAuth
# client, and no SmartThings device IDs.

# --- Displays ---------------------------------------------------------------
# TV_HOST_* is the last known address — a hint. TV_MAC_* is the stable identity:
# when the address stops answering, the service scans the subnet, identifies the
# display by MAC and remembers where it found it. That is what keeps this
# working without a DHCP reservation.
TV_HOST_S95=192.168.18.187
TV_MAC_S95=F0:70:4F:32:BF:DA

TV_HOST_M7=192.168.18.186
TV_MAC_M7=54:44:A3:5C:4B:16

# Same Tizen app on both displays.
TV_APP_ID=tvweather1.tvweather

# Leave empty to scan the subnet implied by TV_HOST_*. Set it only if the
# displays live somewhere other than their last known address suggests.
TV_SCAN_SUBNET=

# --- API tokens -------------------------------------------------------------
# Generate each separately:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Do NOT use one value for both. The read token ships inside the .wgt package on
# the TV, so it must not be able to forge sensor readings.

# Write — the ESP32 sensor. Guards POST /ingest.
INGEST_TOKEN=

# Read — the TV and phone apps. Guards GET /api/weather and /api/weather/history.
READ_TOKEN=

# Act — the Edge driver. Guards POST /launch-tv-app.
# LEAVE EMPTY. The driver sends no credentials, so setting this breaks your
# routine until the driver is republished with the header.
ACTION_TOKEN=

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
