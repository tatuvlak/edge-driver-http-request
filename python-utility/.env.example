# Environment configuration for TV App Launcher

# ============================================
# SmartThings OAuth Configuration (LEGACY - optional)
# ============================================
# Launching the app no longer uses SmartThings at all, so you can leave this
# whole section empty and the service will start and work normally. It is only
# read by the /device-status endpoint, which goes away with the rest of the
# SmartThings code.
# Get these from: https://smartthings.developer.samsung.com/
ST_CLIENT_ID=your-smartthings-client-id
ST_CLIENT_SECRET=your-smartthings-client-secret
ST_REFRESH_TOKEN=your-refresh-token-from-oauth-flow

# OAuth Settings
# Use external callback since this runs on local NAS (not internet-accessible)
# This should point to your GitHub Pages callback: https://YOUR_USERNAME.github.io/tv-weather-oauth/callback.html
OAUTH_REDIRECT_URI=https://tatuvlak.github.io/tv-weather-oauth/callback.html
TOKEN_FILE=/app/data/oauth_tokens.json

# Flask Secret Key (IMPORTANT: change this to a random string in production)
SECRET_KEY=change-this-to-a-random-secret-key

# ============================================
# SmartThings PAT (LEGACY - Deprecated)
# ============================================
# Only needed if OAuth is not configured
# Get this from: https://account.smartthings.com/tokens
# SMARTTHINGS_PAT=your-personal-access-token-here

# ============================================
# TV/Monitor Configuration  (local control)
# ============================================
# Launching no longer goes through SmartThings. The service POSTs directly to
# each display's own API on the LAN, so what it needs is an address, not a
# SmartThings device ID.
#
# Give each display a DHCP reservation on your router so these stay put.

# S95 TV — the default target
TV_HOST_S95=192.168.18.187

# M7 Monitor — optional second display
TV_HOST_M7=192.168.18.186

# Your weather app ID (Tizen app ID) - same app on both displays
TV_APP_ID=tvweather1.tvweather

# The SmartThings routine powers the display on before calling this service,
# but its network stack takes a few seconds to come up. How long to wait for it
# to answer, and how many times to retry the launch itself.
TV_READY_TIMEOUT=30
TV_LAUNCH_ATTEMPTS=3

# ============================================
# Legacy SmartThings device IDs
# ============================================
# No longer used for launching. Only the /device-status endpoint still reads
# these, and that goes away with the rest of the SmartThings code.
# TV_DEVICE_ID_S95=your-s95-tv-device-id-here
# TV_DEVICE_ID_M7=your-m7-monitor-device-id-here

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=5000
