# Environment configuration for TV App Launcher

# ============================================
# SmartThings OAuth Configuration (LEGACY - optional)
# ============================================
# Launching the app no longer uses SmartThings at all, so you can leave this
# whole section empty and the service will start and work normally. It is only
# read by the /device-status endpoint, which goes away with the rest of the
# SmartThings code.
# Get these from: https://smartthings.developer.samsung.com/
ST_CLIENT_ID=your-smartthings-client-id
ST_CLIENT_SECRET=your-smartthings-client-secret
ST_REFRESH_TOKEN=your-refresh-token-from-oauth-flow

# OAuth Settings
# Use external callback since this runs on local NAS (not internet-accessible)
# This should point to your GitHub Pages callback: https://YOUR_USERNAME.github.io/tv-weather-oauth/callback.html
OAUTH_REDIRECT_URI=https://tatuvlak.github.io/tv-weather-oauth/callback.html
TOKEN_FILE=/app/data/oauth_tokens.json

# Flask Secret Key (IMPORTANT: change this to a random string in production)
SECRET_KEY=change-this-to-a-random-secret-key

# ============================================
# SmartThings PAT (LEGACY - Deprecated)
# ============================================
# Only needed if OAuth is not configured
# Get this from: https://account.smartthings.com/tokens
# SMARTTHINGS_PAT=your-personal-access-token-here

# ============================================
# TV/Monitor Configuration  (local control)
# ============================================
# Launching no longer goes through SmartThings. The service POSTs directly to
# each display's own API on the LAN, so what it needs is an address, not a
# SmartThings device ID.
#
# Give each display a DHCP reservation on your router so these stay put.

# S95 TV — the default target
TV_HOST_S95=192.168.18.187
TV_MAC_S95=F0:70:4F:32:BF:DA

# M7 Monitor — optional second display
TV_HOST_M7=192.168.18.186
TV_MAC_M7=54:44:A3:5C:4B:16

# The MACs matter if your displays get addresses by DHCP. When the address in
# TV_HOST_* stops answering, the service scans the subnet and identifies the
# display by MAC, then remembers where it found it. Without a MAC, a lease
# change breaks the launch until you edit this file.
#
# A DHCP reservation on the router is still the better fix — it stops the
# address moving at all. Treat discovery as the safety net, not the plan.

# Where discovered addresses are remembered. On the mounted volume so a
# rediscovery survives container restarts.
DISPLAY_CACHE_PATH=/app/data/display_ips.json

# Subnet to scan when a display has moved. Leave empty to use the one implied
# by TV_HOST_*, which is right on a normal flat home network. Set it only if
# your displays live on a different subnet from their last known address.
TV_SCAN_SUBNET=

# Your weather app ID (Tizen app ID) - same app on both displays
TV_APP_ID=tvweather1.tvweather

# The SmartThings routine powers the display on before calling this service,
# but its network stack takes a few seconds to come up. How long to wait for it
# to answer, and how many times to retry the launch itself.
TV_READY_TIMEOUT=30
TV_LAUNCH_ATTEMPTS=3

# ============================================
# Legacy SmartThings device IDs
# ============================================
# No longer used for launching. Only the /device-status endpoint still reads
# these, and that goes away with the rest of the SmartThings code.
# TV_DEVICE_ID_S95=your-s95-tv-device-id-here
# TV_DEVICE_ID_M7=your-m7-monitor-device-id-here

# ============================================
# Weather data hub
# ============================================
# The sensor posts readings here; the TV and phone apps read them back. This is
# what replaces reading the station out of the SmartThings cloud.

WEATHER_DB_PATH=/app/data/weather.db

# A reading older than this many seconds is served with stale=true, so the apps
# can say so instead of showing an old number as if it were current. The sensor
# posts every 30s, so this allows a few missed cycles.
WEATHER_STALE_AFTER=120

# How long to keep history. At one reading every 30s that is ~2,900 rows a day.
WEATHER_RETENTION_DAYS=30

# ============================================
# API tokens
# ============================================
# Three separate secrets, because they have very different blast radii. Do NOT
# reuse one value across them: the read token ships inside the .wgt package on
# the TV, so it must never be the one that can forge readings or command
# hardware. Generate each with:  python -c "import secrets;print(secrets.token_urlsafe(32))"

# Write - the ESP32 sensor only. Guards POST /ingest.
INGEST_TOKEN=generate-me-see-command-above

# Read - the TV and phone apps. Guards GET /api/weather and /api/weather/history.
READ_TOKEN=generate-me-see-command-above

# Act - the Edge driver. Guards POST /launch-tv-app.
# LEAVE THIS EMPTY FOR NOW: the Edge driver sends no credentials, so setting it
# breaks your routine until the driver is republished with the header. An empty
# value leaves that one endpoint open, which is the current behaviour anyway.
ACTION_TOKEN=

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=5000
